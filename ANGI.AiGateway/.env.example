# Load via: docker compose --env-file ANGI.AiGateway/.env -f docker-compose.ai-gateway.yml up -d --build
# Copy this file to ANGI.AiGateway/.env (ignored). Never commit filled values.
# Database password: random 32+ hexadecimal characters, no semicolon in the connection-string value.
AI_BUDGET_DB_PASSWORD=
# Backend AI calls use this provider key only through the gateway. Reco is configured independently.
OPENAI_GATEWAY_PROVIDER_KEY=
# Generate two DIFFERENT secrets: angi-chat- / angi-admin- + 32 random bytes encoded as hex.
AI_GATEWAY_CHAT_KEY=
AI_GATEWAY_ADMIN_KEY=
