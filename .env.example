# Local development only. Copy to .env: cp .env.example .env
POSTGRES_PORT=5432
POSTGRES_SUPERUSER_PASSWORD=postgres_dev
ANGI_DB_NAME=angi
ANGI_BACKEND_DB_USER=angi_backend
ANGI_BACKEND_DB_PASSWORD=backend_dev
ANGI_RECO_DB_USER=angi_reco
ANGI_RECO_DB_PASSWORD=reco_dev

# External service keys of the backend. The API does not read this file:
# set each key once with user secrets (README, "External service keys"), e.g.
#   dotnet user-secrets set "Jwt:SecretKey" "<value>" --project ANGI.WebApi
# Render uses environment variables with "__" (Jwt__SecretKey). Get the shared
# dev keys from the team's private channel; never commit a value.
# ConnectionStrings:Default=Host=localhost;Port=5432;Database=angi;Username=angi_backend;Password=backend_dev
# Jwt:SecretKey=
# Recommendation:BaseUrl=http://127.0.0.1:8000
# Recommendation:ApiKey=
# Ai:BaseUrl=http://127.0.0.1:18080/v1/
# AiBudgetGateway:BaseUrl=http://127.0.0.1:18080/v1/
# Ai:ApiKey=<angi-chat-scoped-secret>
# Ai:Model=gpt-6-luna
# Agent:ReasoningEffort=none
# Cloudinary:CloudName=
# Cloudinary:ApiKey=
# Cloudinary:ApiSecret=
# Google:ClientId=
# Brevo:ApiKey=
# Mapbox:AccessToken=
